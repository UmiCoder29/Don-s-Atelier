# ==============================================================================
# Don's Atelier - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS.
# NEVER COMMIT THE ACTUAL .env FILE OR REAL SECRETS.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Database Configuration (Supabase PostgreSQL via Prisma)
# Transaction pooler connection string (port 6543) or direct (port 5432)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Supabase Configuration
# Project URL: https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anon Public Key (Safe for public client-side queries with RLS)
SUPABASE_ANON_KEY="your-supabase-anon-key-placeholder"

# Supabase Service Role Secret Key
# WARNING: NEVER prefix with NEXT_PUBLIC_. Server-side use only.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-placeholder"

# Seed Script Credentials (Required for seeding admin and customer accounts)
# Passwords must be defined here and NEVER hardcoded in source files.
SEED_ADMIN_PASSWORD="your-secure-admin-password"
SEED_CUSTOMER_PASSWORD="your-secure-customer-password"

# Field-Level Encryption Key (AES-256-GCM: 256-bit / 32-byte key as 64-character hex or base64)
# For key rotation, supply versioned mapping in FIELD_ENCRYPTION_KEYS='{"v1":"...", "v2":"..."}'
FIELD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
FIELD_ENCRYPTION_ACTIVE_KEY_ID="v1"

# Trusted Client IP Header
# Set it to the one header your hosting platform guarantees (none, x-vercel-forwarded-for, cf-connecting-ip, x-real-ip)
TRUSTED_IP_HEADER="none"

